# Mattermost
MATTERMOST_URL=https://chat.bsscommerce.com/api/v4
# Danh sách channel IDs phân tách bởi dấu phẩy
MATTERMOST_CHANNELS=channel_id_1,channel_id_2,channel_id_3

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

OPENROUTER_API_KEY=sk-....
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Tuning
MAX_PAGES_PER_CHANNEL=50
MIN_MESSAGES_THRESHOLD=100

# Output
OUTPUT_DIR=./output/profiles
