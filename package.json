{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "keywords": [
    "rag",
    "document"
  ],
  "license": "ISC",
  "author": "quyenpv",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run backend/__tests__/unit",
    "test:integration": "vitest run backend/__tests__/integration",
    "dev:server": "nodemon backend/server.js",
    "dev:rag": "node -e \"const {spawn}=require('child_process');const py=process.platform==='win32'?'.venv/Scripts/python':'.venv/bin/python';spawn(py,['rag/main.py'],{stdio:'inherit',env:{...process.env,PYTHONPATH:'./rag'}}).on('exit',c=>process.exit(c??0))\"",
    "dev:ui": "npm run dev --prefix ui",
    "dev": "concurrently -n \"server,ui,rag\" --kill-others-on-fail --prefix-colors \"blue,green,magenta\" \"npm run dev:server\" \"npm run dev:ui\" \"npm run dev:rag\""
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@langchain/classic": "^1.0.27",
    "@langchain/community": "^1.1.25",
    "@langchain/core": "^1.1.36",
    "@langchain/openai": "^1.3.1",
    "@langchain/textsplitters": "^1.0.1",
    "@notionhq/client": "^5.19.0",
    "@tavily/core": "^0.7.2",
    "axios": "^1.14.0",
    "chromadb": "^3.4.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "imapflow": "^1.3.2",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.2.37",
    "mammoth": "^1.12.0",
    "mathjs": "^15.2.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.3.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^8.0.5",
    "openai": "^6.33.0",
    "pdf-parse": "^1.1.4",
    "qrcode": "^1.5.4",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.4"
  }
}
